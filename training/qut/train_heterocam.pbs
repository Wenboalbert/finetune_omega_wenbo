#!/bin/bash
#PBS -N omega_heterocam_train
#PBS -q saivt_igpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=96gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
PROJECT_ROOT=/home/n12388815/phd/vggt_omega_project/finetune_omega_wenbo
OMEGA_ROOT=/home/n12388815/phd/vggt_omega_project/offer_omega_original_model
CONDA_ENV=/home/n12388815/phd/vggt_omega_project/env_finetune
CONDA_SH=/mnt/weka/pkg/rhel94/AuthenticAMD-25/software/Anaconda3/2024.02-1/etc/profile.d/conda.sh
CONFIG="${CONFIG:-$PROJECT_ROOT/training/configs/heterocam_camera_only.json}"
RESUME="${RESUME:-}"
mkdir -p "$PROJECT_ROOT/logs"
STAMP=$(date +%Y%m%d_%H%M%S)
exec >"$PROJECT_ROOT/logs/train_${STAMP}_${PBS_JOBID:-manual}.log" 2>&1
module purge 2>/dev/null || true
# No CUDA module: the installed PyTorch wheel carries its CUDA runtime.
source "$CONDA_SH"
conda activate "$CONDA_ENV"
export VGGT_OMEGA_PATH="$OMEGA_ROOT"
export PYTHONPATH="$OMEGA_ROOT:$PROJECT_ROOT/training:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${PBS_NCPUS:-8}"
cd "$PROJECT_ROOT"
nvidia-smi
python -c 'import torch,vggt_omega; print(torch.__version__, torch.version.cuda, torch.cuda.is_available()); print(vggt_omega.__file__)'
python training/preflight_heterocam.py --config "$CONFIG"
if [ -n "$RESUME" ]; then
  /usr/bin/time -v python training/train_heterocam.py --config "$CONFIG" --resume "$RESUME"
else
  /usr/bin/time -v python training/train_heterocam.py --config "$CONFIG"
fi
