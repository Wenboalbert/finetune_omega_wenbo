#!/bin/bash
#PBS -N omega_heterocam_eval
#PBS -q saivt_igpu
#PBS -l select=1:ncpus=6:ngpus=1:mem=80gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail
PROJECT_ROOT=/home/n12388815/phd/vggt_omega_project/finetune_omega_wenbo
OMEGA_ROOT=/home/n12388815/phd/vggt_omega_project/offer_omega_original_model
CONDA_ENV=/home/n12388815/phd/vggt_omega_project/env_finetune
CONDA_SH=/mnt/weka/pkg/rhel94/AuthenticAMD-25/software/Anaconda3/2024.02-1/etc/profile.d/conda.sh
CONFIG="${CONFIG:-$PROJECT_ROOT/training/configs/heterocam_camera_only.json}"
CHECKPOINT="${CHECKPOINT:-$PROJECT_ROOT/runs/ue_camera_only_v1/best_passed.pt}"
OUTPUT_DIR="${OUTPUT_DIR:-$PROJECT_ROOT/runs/ue_camera_only_v1/final_eval}"
mkdir -p "$PROJECT_ROOT/logs"
STAMP=$(date +%Y%m%d_%H%M%S)
exec >"$PROJECT_ROOT/logs/eval_${STAMP}_${PBS_JOBID:-manual}.log" 2>&1
module purge 2>/dev/null || true
source "$CONDA_SH"
conda activate "$CONDA_ENV"
export VGGT_OMEGA_PATH="$OMEGA_ROOT"
export PYTHONPATH="$OMEGA_ROOT:$PROJECT_ROOT/training:${PYTHONPATH:-}"
cd "$PROJECT_ROOT"
nvidia-smi
python training/eval_heterocam.py --config "$CONFIG" --checkpoint "$CHECKPOINT" --output-dir "$OUTPUT_DIR"
