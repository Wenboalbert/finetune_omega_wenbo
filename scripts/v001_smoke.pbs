#!/bin/bash
#PBS -N omega_v001_f40
#PBS -q gpu_batch
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb:gpu_model=A100:qlist=saivt_igpu
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?GPU execution requires PBS}"
: "${V001_RUN:?Pass one prepared run directory}"
: "${V001_COMMIT:?Pass the reviewed V001 commit}"
PROJECT_ROOT=/home/n12388815/phd/vggt_omega_project/finetune_omega_wenbo/v001-focal-only-register-token
OMEGA_ROOT=/home/n12388815/phd/vggt_omega_project/vggt-omega_wenbo/offer_omega_original_model
PYTHON=/home/n12388815/phd/vggt_omega_project/env_finetune/bin/python
PROJECT_ROOT=$(readlink -f "$PROJECT_ROOT")
V001_RUN=$(readlink -f "$V001_RUN")
case "$V001_RUN" in "$PROJECT_ROOT"/runs/*) ;; *) exit 2 ;; esac
cd "$PROJECT_ROOT"
test "$(git rev-parse HEAD)" = "$V001_COMMIT"
test -z "$(git status --porcelain)"
export PYTHONPATH="$PROJECT_ROOT/src:$OMEGA_ROOT"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1
export OPENCV_IO_ENABLE_OPENEXR=1
exec >"$V001_RUN/logs/pbs_${PBS_JOBID}.log" 2>&1
nvidia-smi
"$PYTHON" -m residual_tto.runner --run "$V001_RUN" --stage preflight
"$PYTHON" -m residual_tto.runner --run "$V001_RUN" --stage smoke
# A separate process is the only component allowed to load pose/depth GT.
"$PYTHON" -m residual_tto.evaluate --run "$V001_RUN"
